node_modules/
*.log

# Live capture bundles are private-local by default. The manifest itself carries
# document identity and the raw/screenshot/override files may contain client copy,
# assets, variable names, or node ids. Authorized sanitized regression fixtures
# live under tests/fixtures/captures/ instead.
docs/research/*/capture-manifest.json
docs/research/*/slot-overrides.json
docs/research/*/raw/
docs/research/*/screenshots/
docs/research/*/normalized/

# Legacy raw-response naming.
docs/research/**/*.raw.json

# Derived artifacts inherit their capture's commit policy. A tokens.source.json
# extracted from a private-local capture still quotes that file's node ids,
# internal style names, and measurements, so it is no more publishable than the
# raw/ bundle it came from. `npm run extract` prints a reminder when the capture
# it just read is private-local; add the brand here when it is.
# (design-systems/psiativa/ is Juan's own and stays committed as the R0 fixture.)
design-systems/syd/
.env
.env.*
